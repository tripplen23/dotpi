{
  "mcpServers": {
    "playwright-chrome": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome"
      ],
      "cwd": "~/.pi/agent"
    },
    "playwright-webkit": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "webkit"
      ],
      "cwd": "~/.pi/agent"
    },
    "firecrawl": {
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "headers": {
        "Authorization": "!. $HOME/.pi/agent/env.sh && echo Bearer $PI_FIRECRAWL_API_KEY"
      }
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "!. $HOME/.pi/agent/env.sh && echo $PI_EXA_API_KEY"
      }
    }
  }
}
